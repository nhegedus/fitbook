# The `default` target of ./Dockerfile, for Railway: its builder refuses a Dockerfile with a
# VOLUME instruction anywhere in it (the coach stage has one), so this file carries only the
# stages the default image needs. Railway's own volume is mounted at /data instead.
# Select it with the service variable RAILWAY_DOCKERFILE_PATH=Dockerfile.railway.
FROM node:22.23.4-alpine
WORKDIR /app
RUN apk upgrade --no-cache
RUN adduser -D -H -s /sbin/nologin coach
COPY package.json package-lock.json* ./
RUN npm ci --omit=dev --omit=optional && npm cache clean --force
COPY server.js push-messages.js nudge.js nudge-copy.js wrapped.js wrapped-copy.js verify-error.js password.js rate-limit.js passkeys-store.js device-link.js watch-relay.js media.js queue.js sync-stamps.js durable.js admin-socket.js recover.js net-guard.js food-search.js ./
COPY coach ./coach
COPY integrations ./integrations
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/bin/npm /usr/local/bin/npx
ENV NODE_ENV=production
ENV PORT=3000
EXPOSE 3000
CMD ["node", "server.js"]
